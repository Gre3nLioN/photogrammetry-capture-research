{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Photogrammetry Capture Research Experiment Manifest",
  "type": "object",
  "required": ["schema_version", "experiment_id", "protocol", "baseline", "selection", "source_images", "subset_fingerprint_sha256", "repetitions"],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "protocol": {"type": "string"},
    "hypothesis": {"type": "string"},
    "baseline": {
      "type": "object",
      "required": ["quality_report", "dataset_fingerprint_sha256"],
      "properties": {
        "quality_report": {"type": "string"},
        "dataset_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "source_images": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "selection": {
      "type": "object",
      "required": ["strategy", "selected_image_ids", "excluded_image_ids"],
      "properties": {
        "strategy": {"enum": ["full", "stride", "random", "sector-removal", "contiguous-gap", "explicit"]},
        "parameters": {"type": "object"},
        "selected_image_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_image_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "transformations": {"type": "array", "items": {"type": "object", "required": ["kind", "parameters"]}},
    "subset_fingerprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repetitions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "seed"]}}
  }
}
